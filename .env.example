# ============================================================
# 翻译服务配置 —— 复制本文件为 .env.local 后填写
# ⚠️ .env.local 已在 .gitignore 中，永远不要提交到仓库
# ⚠️ 不要给任何变量加 NEXT_PUBLIC_ 前缀，否则 Key 会被打进前端包
#
# 只需要填两个：接口地址 + API Key
# 模型、服务商类型、限流、长度上限全部自动处理
# ============================================================

# ---------- 必填 1/2：API 接口地址 ----------
# 只填到 /v1（或网关根路径），不要带 /chat/completions
# OpenAI      → https://api.openai.com/v1
# Agnes APIHub→ https://apihub.agnes-ai.com/v1
# DeepSeek    → https://api.deepseek.com/v1
# 通义千问    → https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepL       → https://api-free.deepl.com/v2  （会自动识别为 DeepL）
TRANSLATE_BASE_URL=https://api.openai.com/v1

# ---------- 必填 2/2：API Key ----------
TRANSLATE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# 以下全部可选，一般不用填
# ============================================================

# 手动锁定模型（填了就不做自动侦测）
# TRANSLATE_MODEL=gpt-4o-mini

# 单 IP 每分钟请求上限，防止 Key 被盗刷
# RATE_LIMIT_PER_MINUTE=30

# 单次请求最大字符数
# MAX_TEXT_LENGTH=4000
